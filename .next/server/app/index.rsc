26:["$","$L25","sabrani-cups",{"product":{"id":"sabrani-cups","slug":"sabrani-cups","name":"Sabrani Sambrani Cups","category":"dhoop","categoryLabel":"Dhoop","featured":true,"shortDescription":"Convenient Sabrani cups (Big and Small) for a traditional sambrani experience without the hassle.","description":"Experience the timeless fragrance of traditional sambrani with our easy-to-use Sabrani Cups. Available in big and small sizes, these cups are pre-filled and ready to light, offering a rich, purifying smoke ideal for cleansing your home environment.","images":["/products/sabrani-cups.png"],"highlights":["Ready to use, no hassle","Authentic sambrani fragrance","Purifies and cleanses the air","Includes both big and small cups"],"material":"Natural sambrani and cow dung base","dimensions":"Assorted (Big and Small)","weight":"Standard","packSize":"1 Box (Mixed sizes)","quantity":"Standard Pack","usage":["Air Purification","Special Puja","Festivals"],"howToUse":["Hold the cup from the base and light the top rim.","Wait for the rim to glow evenly, then gently blow out the flame.","Place it on the provided heat-safe plate."],"suitableFor":"Cleansing home energy, festive occasions, and special pujas.","storage":"Keep in an airtight container away from moisture.","safety":"Place only on a heat-resistant surface. Keep away from flammable materials and children.","benefits":["Quick and convenient sambrani experience","Deeply purifying aroma","Helps in meditation and relaxation"],"faqs":[{"q":"Are they easy to light?","a":"Yes, they are designed to light easily and burn evenly."},{"q":"Can they be used indoors?","a":"Yes, but ensure the room is well-ventilated as they produce thick, fragrant smoke."}]},"index":2}]
27:["$","$L25","cow-weight-measuring-tape",{"product":{"id":"cow-weight-measuring-tape","slug":"cow-weight-measuring-tape","name":"Cow Weight Measuring Tape","category":"machines","categoryLabel":"Machines","featured":true,"shortDescription":"Accurate and easy-to-use measuring tape to estimate the weight of cattle instantly.","description":"Our Cow Weight Measuring Tape is an essential tool for modern dairy farmers. It allows you to quickly and accurately estimate the weight of your cattle without the need for a bulky weighing scale. Simply measure the heart girth and read the corresponding weight on the tape.","images":["/products/cow-weight-tape.jpeg"],"highlights":["Accurate weight estimation","Durable, tear-resistant material","Easy to read markings","Portable and lightweight"],"material":"High-quality PVC fiberglass","dimensions":"Length: 2.5 meters (approx)","weight":"Lightweight","packSize":"1 Piece","quantity":"Standard","usage":["Dairy Farms","Cattle Health Monitoring","Veterinary Use"],"howToUse":["Keep the cow calm and standing straight.","Wrap the tape around the cow's heart girth, just behind the front legs.","Pull the tape snug but not too tight.","Read the estimated weight directly from the tape."],"suitableFor":"Cows and other cattle.","storage":"Wipe clean after use and store in a dry place.","safety":"Handle cattle gently during measurement.","benefits":["Helps monitor cattle health and growth","Aids in calculating feed requirements","Useful for determining medication dosages"],"faqs":[{"q":"Is it accurate?","a":"It provides a highly reliable estimate for most cattle breeds based on girth."},{"q":"Can it measure other animals?","a":"It is specifically calibrated for the proportions of cattle."}]},"index":3}]
